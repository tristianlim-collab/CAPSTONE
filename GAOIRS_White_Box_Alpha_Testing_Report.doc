            <tr>
                <td><strong>TC-W016</strong></td>
                <td><code>editIncident()</code></td>
                <td>Non-ADMIN incident edit guard</td>
                <td><code>user.role: "RESPONSE_UNIT"</code></td>
                <td>Returns 403 Forbidden ("Only admins can edit").</td>
